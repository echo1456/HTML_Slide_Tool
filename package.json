{
  "name": "html-slide-tool",
  "version": "5.8.9",
  "private": true,
  "description": "Zero-bundler Strict-CSP Interactive HTML Presentation Studio & PWA",
  "scripts": {
    "serve": "python3 tests/csp-server.py --port 4173",
    "test:static": "python3 -W error build.py --test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "python3 -W error build.py --test && playwright test",
    "build": "python3 -W error build.py",
    "package": "python3 -W error build.py --package"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
